# --- Runtime ---Copy this file to ur env

ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# --- Supabase ---
# From Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=paste-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
SUPABASE_JWT_SECRET=paste-jwt-secret-here

# --- Database ---
# From Dashboard → Settings → Database → Connection pooling → Session
# Password must be URL-encoded if it contains special chars (@ : / # ? etc.)
DATABASE_URL=postgresql://postgres.your-project:pasted-url-encoded-password@aws-0-region.pooler.supabase.com:6543/postgres

# --- Encryption (generate with: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())") ---
FEDRETINA_MASTER_KEY_B64=paste-master-key-here
FEDRETINA_NODE_HMAC_KEY_NODE01_B64=paste-node01-key-here
FEDRETINA_NODE_HMAC_KEY_NODE02_B64=paste-node02-key-here
FEDRETINA_NODE_HMAC_KEY_NODE03_B64=paste-node03-key-here

# --- Storage ---
SUPABASE_SCANS_BUCKET=fedretina-scans

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server hardening ---
REQUEST_TIMEOUT_SECONDS=30
MAX_UPLOAD_SIZE_BYTES=26214400